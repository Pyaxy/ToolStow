# ToolStow v0.2.2 Configuration Template
# Copy to `.env` in the working directory before running `toolstow`.
# Precedence: CLI flags > process environment variables > `.env` > defaults.

# ---------------------------------------------------------------------------
# Network & Data Directory
# ---------------------------------------------------------------------------

# Bind address (default: 127.0.0.1; use 0.0.0.0 when listening behind Docker/VPS proxy)
# TOOLSTOW_HOST=127.0.0.1

# Listen port (default: 8080)
# TOOLSTOW_PORT=8080

# Unified runtime data directory (default: ./data)
# Contains:
#   - <data-dir>/tools/        (installed micro-tools + .staging/)
#   - <data-dir>/theme/        (optional custom static public frontend override)
#   - <data-dir>/settings.json (siteTitle, siteDescription, defaultAccent)
# TOOLSTOW_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Dual-Key Authentication (Fail-Closed by Default)
# ---------------------------------------------------------------------------
# Both keys are optional; leaving a key unset/empty disables that auth channel.
# Use strong random keys (>= 16 chars recommended; generate two DISTINCT keys):
#   openssl rand -hex 32

# Human administrator single-key login for `/admin` (exchanged for an in-memory
# 256-bit HttpOnly SameSite=Strict session cookie, 24h TTL).
# Grants full management of tools, draft preview/toggling, and site settings.
# Generate with: openssl rand -hex 32
# TOOLSTOW_ADMIN_KEY=

# Machine / AI / curl / MCP Bearer token (`Authorization: Bearer <token>`) for
# `/api/admin/tools*` (list all including drafts, upload/overwrite zip, PATCH
# draft status, DELETE). CANNOT log into `/admin` or modify site settings.
# Generate a SEPARATE key with: openssl rand -hex 32
# TOOLSTOW_API_KEY=

# ---------------------------------------------------------------------------
# Draft Visibility & Cookie Security
# ---------------------------------------------------------------------------

# Show `draft: true` tools on public `/api/tools` and `/t/{id}/*` without admin
# login (default: false). Enable ONLY for local development/preview.
# TOOLSTOW_INCLUDE_DRAFTS=false

# Force the `Secure` attribute on the admin session cookie (default: false).
# Recommended to set `true` when serving ToolStow over HTTPS / TLS reverse proxy.
# TOOLSTOW_COOKIE_SECURE=false
